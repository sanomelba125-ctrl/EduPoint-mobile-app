# ===================================================================
# 学生活动打卡与积分管理系统 - 移动学生端生产环境变量
# ===================================================================

# 生产环境严禁模拟定位，严格执行 fail-closed 防作弊
VITE_ENABLE_MOCK_LOCATION=false

# 生产环境 API 基地址与 WebSocket 基地址
VITE_APP_BASE_URL=/api
# 生产环境 WebSocket 基地址 (微信正式版要求 wss + 已备案域名，必须显式配置，如 wss://api.yourdomain.com/api/ws；无同源推导与轮询降级；留空时小程序端 WS 不可用，H5 端走同源自适应不受影响)
VITE_APP_WS_URL=

