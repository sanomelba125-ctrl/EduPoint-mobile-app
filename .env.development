# ===================================================================
# 学生活动打卡与积分管理系统 - 移动学生端本地开发环境变量
# ===================================================================

# 考勤定位模拟开关（防作弊门禁）
# false (默认): 严格强制硬件 GPS 定位，未获取到真实坐标拒绝打卡 (fail-closed)
# true: 仅限在无 GPS 传感器的 PC 浏览器端调试时，将活动基准点坐标作为模拟定位
VITE_ENABLE_MOCK_LOCATION=false

# 小程序/App 端直连后端 API 基地址
VITE_APP_BASE_URL=http://localhost:8080/api

# 小程序/App 端 WebSocket 实时连接基地址
VITE_APP_WS_URL=ws://localhost:8080/api/ws
