{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/activity/index",
      "style": {
        "navigationBarTitleText": "活动打卡大厅",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/gift/index",
      "style": {
        "navigationBarTitleText": "积分兑换商城",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/rank/index",
      "style": {
        "navigationBarTitleText": "积分排行榜",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/my/index",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "学生身份认证"
      }
    },
    {
      "path": "pages/gift/detail",
      "style": {
        "navigationBarTitleText": "礼品兑换详情"
      }
    },
    {
      "path": "pages/my/orders",
      "style": {
        "navigationBarTitleText": "我的兑换订单",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/my/points",
      "style": {
        "navigationBarTitleText": "积分收支明细",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/activity/detail",
      "style": {
        "navigationBarTitleText": "活动详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/activity/checkin",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "现场扫码考勤打卡",
        "navigationBarBackgroundColor": "#0f172a",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/activity/records",
      "style": {
        "navigationBarTitleText": "我的活动记录",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/notice/index",
      "style": {
        "navigationBarTitleText": "消息通知中心",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/certificate/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "权威电子结项证书",
        "navigationBarBackgroundColor": "#0f172a",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/certificate/verify",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "电子荣誉证书真伪核验",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/ai-chat/index",
      "style": {
        "navigationBarTitleText": "AI 智能客服",
        "navigationBarBackgroundColor": "#0f172a",
        "navigationBarTextStyle": "white",
        "app-plus": {
          "softinputMode": "adjustResize"
        }
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "学生活动打卡",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f6f8"
  },
  "tabBar": {
    "color": "#64748b",
    "selectedColor": "#2563eb",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/activity/index",
        "text": "活动打卡",
        "iconPath": "static/tabbar/activity.png",
        "selectedIconPath": "static/tabbar/activity-active.png"
      },
      {
        "pagePath": "pages/gift/index",
        "text": "积分商城",
        "iconPath": "static/tabbar/gift.png",
        "selectedIconPath": "static/tabbar/gift-active.png"
      },
      {
        "pagePath": "pages/rank/index",
        "text": "排行榜",
        "iconPath": "static/tabbar/rank.png",
        "selectedIconPath": "static/tabbar/rank-active.png"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的",
        "iconPath": "static/tabbar/my.png",
        "selectedIconPath": "static/tabbar/my-active.png"
      }
    ]
  }
}
