{
  "name": "学生活动打卡移动端",
  "appid": "",
  "description": "供学生进行活动签到打卡、查看积分、兑换礼品",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueCompiler": "uni-app",
    "compilerVersion": 3,
    "modules": {
      "Geolocation": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>"
        ]
      },
      "ios": {
        "privacyDescription": {
          "NSLocationWhenInUseUsageDescription": "用于活动地图导航、距离计算和现场打卡范围核验"
        }
      }
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于活动地图导航、距离计算和现场打卡范围核验"
      }
    },
    "requiredPrivateInfos": [
      "getLocation"
    ]
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "h5": {
    "title": "学生活动打卡与积分兑换平台",
    "router": {
      "mode": "hash"
    }
  }
}
